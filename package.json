{
  "name": "sarah-personal-website",
  "version": "1.0.0",
  "description": "Personal developer portfolio website built with Angular",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:ghpages": "ng build --configuration production --base-href /sarah-personal-website/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "cross-env MSYS_NO_PATHCONV=1 ng build --base-href=/personal_website/ && npx angular-cli-ghpages --dir=dist/sarah-personal-website/browser"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@types/node": "^20.0.0",
    "angular-cli-ghpages": "^2.0.3",
    "cross-env": "^10.1.0",
    "typescript": "~5.4.0"
  }
}
